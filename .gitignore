# Raw examples may contain personal details: never commit
data/raw/
.env
__pycache__/
*.pyc
.venv/

# Real messages from family and friends: keep out of Git, so the repo can go public later
data/labeled_messages.csv
data/review_my_phone.csv
.pytest_cache/
# Downloaded datasets: re-download instead of committing
data/external/
# Trained models: the TF-IDF model and the embeddings cache contain words/vectors from
# the private messages and stay out. alephbert.joblib holds only 768 learned weights
# (no text) and is needed by GitHub Actions to test and build.
models/*
!models/alephbert.joblib
.claude/
# Terraform: local state and plugins stay out of Git (state lists cloud resource details)
infra/.terraform/
infra/*.tfstate
infra/*.tfstate.*
infra/*.tfplan
infra/*_plan
infra/terraform.tfvars
